{
  "manifest_version": 3,
  "name": "アクティカウンター",
  "version": "0.1.0",
  "description": "アクティメソッドのタイピング回数と学習時間を記録します。",
  "permissions": [
    "storage",
    "alarms",
    "webNavigation"
  ],
  "action": {
    "default_title": "アクティカウンター",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://acti-island.com/typing",
        "https://acti-island.com/typing/*"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
